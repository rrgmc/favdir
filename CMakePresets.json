{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (MSVC 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/.qt/6.8.3/msvc2022_64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-ninja",
      "displayName": "Windows (Ninja, any MSVC; run from a developer prompt)",
      "inherits": "windows",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/windows-ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS (Ninja)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/macos",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/.qt/6.8.3/macos",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows",
      "configuration": "Debug"
    },
    {
      "name": "windows-ninja",
      "configurePreset": "windows-ninja",
      "configuration": "Release"
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "configuration": "Release"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-ninja",
      "configurePreset": "windows-ninja",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
